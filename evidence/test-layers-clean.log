check_layers() {
  local image="$1"
  local work layerdir
  work="$(mktemp -d)"
  layerdir="$work/unpacked"
  # 归档格式有两种，**都要兼容**：
  #   docker-archive（旧）：<hash>/layer.tar
  #   OCI（buildx 推送的默认格式）：blobs/sha256/<digest>（层是无扩展名的 tar）
  # 只认前一种 ⇒ 在 buildx 推的镜像上会误判成"未发现任何镜像层"。
  docker save "$image" | tar -x -C "$work"
  local found=0 unpacked=0
  while IFS= read -r layer; do
    rm -rf "${layerdir:?}"/* 2>/dev/null || true
    mkdir -p "$layerdir"
    # 非 tar 成员（OCI 的 config json）解包会失败 ⇒ 跳过，不算层
    tar -x -f "$layer" -C "$layerdir" 2>/dev/null || continue
    [ -n "$(ls -A "$layerdir" 2>/dev/null)" ] || continue
    unpacked=$((unpacked+1))
    if find "$layerdir" \( -name '.env' -o -name '.env.*' -o -name '.git' \) -print -quit | grep -q .; then
      echo "::error::$image 镜像层 $layer 内发现 .env 或 .git"
      found=1
    fi
  done < <(find "$work" -type f \( -name 'layer.tar' -o -path '*/blobs/sha256/*' \) 2>/dev/null)
  rm -rf "$work"
  [ "$unpacked" -gt 0 ] || { echo "::error::$image 未发现任何可解包的镜像层"; exit 1; }
  [ "$found" -eq 0 ] || exit 1
  echo "$image layers clean (解包 $unpacked 层)"
}
check_layers ghcr.io/awkn-lab/clawhunt-3158-backend:sha-259ab24
check_layers ghcr.io/awkn-lab/clawhunt-3158-web:sha-259ab24
shell: /usr/bin/bash -e {0}
env:
  REGISTRY: 
  NAMESPACE: 
