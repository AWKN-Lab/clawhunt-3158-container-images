##[group]Run set -euo pipefail
set -euo pipefail
for repo in clawhunt-3158-backend clawhunt-3158-web; do
  # owner 是**用户账号**（实测 /users/AWKN-Lab → 200、/orgs/AWKN-Lab → 404），
  # GHCR 的容器包路径用 users/<owner>；先试 users，再回退 orgs（万一以后转组织）。
  versions="$(gh api --paginate "users/awkn-lab/packages/container/$repo/versions" --jq '.[].metadata.container.tags[]' 2>/dev/null)" \
    || versions="$(gh api --paginate "orgs/awkn-lab/packages/container/$repo/versions" --jq '.[].metadata.container.tags[]' 2>/dev/null)" \
    || { echo "::error::$repo 在 GHCR 上查不到版本"; exit 1; }
  test -n "$versions" || { echo "::error::$repo 在 GHCR 上没有版本"; exit 1; }
  echo "$repo tags:"
  printf '%s\n' "$versions"
  printf '%s\n' "$versions" | grep -qx 'latest' && { echo "::error::$repo 存在 latest 标签"; exit 1; }
done
echo "no latest tag on GHCR: ok"
shell: /usr/bin/bash -e {0}
env:
  REGISTRY: 
  NAMESPACE: 
  GH_TOKEN: ***
##[endgroup]
